# Copy to .env and fill in. docker-compose reads this file; for local `npm run dev`
# each service also reads its own .env, so symlink or copy as needed.
#
# Generate the two secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------- database
POSTGRES_USER=cf
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=chevella_stall
DATABASE_URL=postgres://cf:change-me-strong-password@db:5432/chevella_stall

# ---------------------------------------------------------------- secrets
# Signs the admin session cookie. Changing it logs everyone out.
JWT_SECRET=replace-with-openssl-rand-hex-32
# Shared key the Android app sends as x-api-key. Baked into the APK at build time.
DEVICE_API_KEY=replace-with-openssl-rand-hex-32
# Salts the hash of visitor IPs in the scan log. Raw IPs are never stored.
IP_HASH_SALT=replace-with-any-random-string

# ---------------------------------------------------------------- URLs
# The public origin of cf-admin. This string goes INSIDE every contact QR code, so it must
# be the real https:// address before you print anything.
PUBLIC_BASE_URL=http://localhost:3000
# Where the phones reach cf-api. With the bundled nginx this is the same host as above.
API_PUBLIC_URL=http://localhost:3000
# Browser origins allowed to call cf-api directly. The admin proxies through Next, so this
# usually only needs the admin origin.
CORS_ORIGINS=http://localhost:3000

# Direct link to the built APK, shown as a QR on the Scanner app page. Optional.
APK_DOWNLOAD_URL=

# ---------------------------------------------------------------- first admin login
# Used once, on the first `npm run migrate`. Delete the password afterwards.
SEED_ADMIN_NAME=Chevella Admin
SEED_ADMIN_EMAIL=admin@chevellafarms.com
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------- service wiring
PORT=4000
NODE_ENV=production
OCR_URL=http://ocr:8000
OCR_TIMEOUT_MS=60000
MAX_UPLOAD_MB=12
STORAGE_DIR=/app/storage
TRUST_PROXY_HOPS=1
API_INTERNAL_URL=http://api:4000

# ---------------------------------------------------------------- brand (printed on PDFs,
# vCards and the public contact page)
BRAND_COMPANY=Chevella Farms
BRAND_LEGAL_NAME=Frister Foods Pvt Ltd
BRAND_TAGLINE=The land of coconut goodness
BRAND_WEBSITE=https://www.chevellafarms.com/
BRAND_PHONE=+919701221934
BRAND_EMAIL=info@fristerfoods.com
BRAND_ADDRESS=701 Babu Khan Millennium Center, Somajiguda, Hyderabad 500082, Telangana, India
