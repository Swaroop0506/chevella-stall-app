{
  "name": "cf-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Chevella Farms stall scanner — photograph visiting cards, no login needed",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "prebuild": "expo prebuild --platform android --clean",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease",
    "fix": "expo install --fix"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "~53.0.0",
    "expo-camera": "~16.1.5",
    "expo-constants": "~17.1.3",
    "expo-file-system": "~18.1.5",
    "expo-image-manipulator": "~13.1.4",
    "expo-network": "~7.1.4",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2"
  }
}
